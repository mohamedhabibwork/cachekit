{
  "name": "@mohamedhabibwork/cachekit",
  "version": "0.2.0",
  "description": "Provider-first, runtime-portable TypeScript caching.",
  "keywords": [
    "cache",
    "memory-cache",
    "redis",
    "swr",
    "ttl",
    "typescript"
  ],
  "homepage": "https://github.com/mohamedhabibwork/cachekit#readme",
  "bugs": {
    "url": "https://github.com/mohamedhabibwork/cachekit/issues"
  },
  "license": "MIT",
  "author": "Mohamed Habib",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohamedhabibwork/cachekit.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "llms.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "require": "./dist/memory.cjs"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "require": "./dist/redis.cjs"
    },
    "./valkey": {
      "types": "./dist/valkey.d.ts",
      "import": "./dist/valkey.js",
      "require": "./dist/valkey.cjs"
    },
    "./dragonfly": {
      "types": "./dist/dragonfly.d.ts",
      "import": "./dist/dragonfly.js",
      "require": "./dist/dragonfly.cjs"
    },
    "./elasticache": {
      "types": "./dist/elasticache.d.ts",
      "import": "./dist/elasticache.js",
      "require": "./dist/elasticache.cjs"
    },
    "./memorystore": {
      "types": "./dist/memorystore.d.ts",
      "import": "./dist/memorystore.js",
      "require": "./dist/memorystore.cjs"
    },
    "./azure-redis": {
      "types": "./dist/azure-redis.d.ts",
      "import": "./dist/azure-redis.js",
      "require": "./dist/azure-redis.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check",
    "publish:if-needed": "node scripts/publish-if-needed.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "redis": "^4.7.0"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
